{
  "name": "reposto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "cat node_modules/@tanstack/react-start/package.json | grep -A8 peerDependencies; ls -a; vite build",
    "start": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "db:create": "wrangler d1 create reposto-db",
    "db:migrate": "wrangler d1 execute reposto-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute reposto-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.167.0",
    "lucide-react": "^0.576.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^4.20240101.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "wrangler": "^4.0.0"
  }
}
