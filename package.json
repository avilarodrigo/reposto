{
  "name": "reposto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vinxi build",
    "start": "wrangler dev",
    "deploy": "vinxi build && wrangler deploy",
    "routes": "tsr generate",
    "db:create": "wrangler d1 create reposto-db",
    "db:migrate": "wrangler d1 execute reposto-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute reposto-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.167.0",
    "lucide-react": "^0.576.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vinxi": "^0.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261010.0",
    "@tanstack/router-cli": "^1.170.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
